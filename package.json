{
  "name": "bjj-notes",
  "version": "0.1.0",
  "description": "Personal BJJ notes, technique graph and focus tracker with an MCP server for Claude and a capture API for Siri",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p web/tsconfig.json"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@electric-sql/pglite": "^0.5.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-query": "^5.105.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
