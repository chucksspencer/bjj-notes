# Copy to .env for local development. In Azure these come from Container Apps secrets.

# Public base URL. The MCP endpoint is <PUBLIC_URL>/mcp. Must be https outside localhost.
PUBLIC_URL=http://localhost:8080
PORT=8080

# Postgres (Neon) connection string. Leave unset locally to use the embedded database.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Where the embedded database keeps its files when DATABASE_URL is unset (omit for in-memory).
PGLITE_DIR=.data/pglite

# The owner's password (12+ characters): the web app, the Claude connector's sign-in page, and inviting others.
OWNER_PASSWORD=change-me-to-something-long

# The owner's bearer token for the Siri Shortcut endpoints (32+ characters): openssl rand -base64 32
# (Anyone can also make tokens on their Account page.)
API_TOKEN=replace-with-a-long-random-string-of-32-plus-chars

# Optional: lets /api/capture use Claude to tidy dictated notes and link them to techniques.
# ANTHROPIC_API_KEY=sk-ant-...
# CAPTURE_MODEL=claude-haiku-5-5

# Time zone used to date notes.
TIME_ZONE=America/Chicago
